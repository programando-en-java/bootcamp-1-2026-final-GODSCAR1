<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.programandoenjava.airline</groupId>
        <artifactId>flight-service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>flight-infrastructure</artifactId>
    <name>flight-infrastructure</name>
    <description>Adapters, configuration and application entry point.</description>

    <dependencies>
        <!-- See flight-domain's pom for why this is provided in every module. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.programandoenjava.airline</groupId>
            <artifactId>flight-application</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Checks tokens against auth-service's published key. It issues, this verifies. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Boot 4 modularization: the Flyway starter, not flyway-core. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Postgres support ships separately from the starter. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Boot 4 modularization: MockMvc support ships separately from
          spring-boot-starter-test. Without it @AutoConfigureMockMvc and the
          org.springframework.boot.webmvc.test.autoconfigure package are not on
          the classpath.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Same reason: @AutoConfigureDataJpa and @AutoConfigureTestEntityManager,
          which EnableDatabaseTest relies on to build a slice with a real
          database behind it.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 modularization: @ServiceConnection support is explicit. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Testcontainers 2 renamed every module with a testcontainers- prefix,
          so the old org.testcontainers:postgresql no longer exists and the Boot
          BOM cannot resolve a version for it.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Architecture rules live here because this is the only module with all
          three layers on its classpath. Placing them in flight-domain would let
          ArchUnit see domain classes only, and any rule about adapters would
          silently pass over an empty set.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit6</artifactId>
            <version>1.5.0</version>
            <scope>test</scope>
        </dependency>

        <!--
          Boot 4 renamed spring-boot-starter-aop to spring-boot-starter-aspectj.
          Without it the @Aspect annotation does not resolve and @UnitOfWork
          silently does nothing.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Only this module is repackaged into an executable jar. Declaring
              the plugin in flight-domain or flight-application would turn their
              jars into fat jars and break them as dependencies.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              Generates the static JPA metamodel (FlightEntity_), which replaces
              string literals inside Specifications: a renamed attribute fails
              to compile, and root.get returns a typed Path instead of
              Path<Object>.

              Declared as an annotation processor path rather than a provided
              dependency. That keeps it off the compile classpath, where its own
              transitive dependencies collide with the application's and produce
              a NoClassDefFoundError for JAXBException.

              hibernate-processor, not hibernate-jpamodelgen: Hibernate 7 renamed
              the artifact, and the old coordinates only resolve by relocation.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.hibernate.orm</groupId>
                            <artifactId>hibernate-processor</artifactId>
                            <version>${hibernate.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>